<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FEFFFF"

    android:orientation="vertical">


    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2386EA">

        <ImageButton
            android:id="@+id/backarrow"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:maxHeight="50dp"
            android:maxWidth="50dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:padding="5dp"
            android:src="@drawable/baseline_arrow_back_24" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:layout_marginLeft="26dp"
            android:src="@drawable/splashscreen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:padding="8dp"
            android:text="Add Card"
            android:textColor="#FDFEFF"
            android:textSize="22dp" />
    </androidx.appcompat.widget.Toolbar>



    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:background="@drawable/container_box"
        android:layout_gravity="center"
        android:layout_margin="5dp"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Card Type"
            android:textStyle="bold"
            android:textColor="#070707"
            android:gravity="center"
            android:textSize="18dp" />





        <!-- Radio Buttons -->
        <RadioGroup android:id="@+id/cardTypeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"

            android:layout_gravity="center">

            <RadioButton
                android:id="@+id/radioDebit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:textColor="#0C0C0C"
                android:textSize="15dp"
                android:text="Debit" />

            <RadioButton
                android:id="@+id/radioCredit"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:textSize="15dp"
                android:textColor="#0C0C0C"

                android:text="Credit" />
        </RadioGroup>

        <!-- Spinner with logos -->



        <TextView
            android:id="@+id/bankSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0C0C0C"
            android:elevation="10dp"
            android:hint="Select Bank"
            android:textColorHint="#2E2C2C"
            android:drawableEnd="@drawable/spinner_down"
            android:backgroundTint="#0F0F10"
            android:outlineAmbientShadowColor="@color/white"

            />

        <TextView
            android:layout_width="wrap_content"
            android:textColor="@color/black"
            android:layout_height="18dp"
            android:text="----------------------------------------------------------------------------------------------------------------"

            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Bank Logo"
            android:textColor="#1B1C1C"
            />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/sbiicon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        android:layout_marginBottom="10dp"
                        android:contentDescription="SBI"
                        android:src="@drawable/sbi"
                        android:tag="sbilogo"
                        android:background="@drawable/edit_text_border" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/hdfcicon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        android:layout_marginBottom="10dp"
                        android:contentDescription="HDFC"
                        android:src="@drawable/hdfc"
                        android:tag="hdfclogo"
                        android:background="@drawable/edit_text_border" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/canaraicon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginBottom="10dp"
                        android:contentDescription="CANARA"
                        android:src="@drawable/canara"
                        android:tag="canaralogo"
                        android:background="@drawable/edit_text_border" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView

                        android:id="@+id/rblicon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="RBL"
                    android:src="@drawable/rbl"
                    android:tag="rbllogo"
                    android:background="@drawable/edit_text_border" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/indusindicon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"

                        android:layout_marginBottom="10dp"
                        android:contentDescription="INDUSIND"
                        android:src="@drawable/indusind"
                        android:tag="indusindlogo"
                        android:background="@drawable/edit_text_border" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iciciicon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"

                        android:layout_marginBottom="10dp"
                        android:contentDescription="ICICI"
                        android:src="@drawable/icici"
                        android:tag="icicilogo"
                        android:background="@drawable/edit_text_border" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/kotakicon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"

                        android:layout_marginBottom="10dp"
                        android:contentDescription="KOTAK"
                        android:src="@drawable/kotak"
                        android:tag="kotaklogo"
                        android:background="@drawable/edit_text_border" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/axisicon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"

                        android:layout_marginBottom="10dp"
                        android:contentDescription="AXIS"
                        android:src="@drawable/axis"
                        android:tag="axislogo"
                        android:background="@drawable/edit_text_border" />


                </LinearLayout>

            </LinearLayout>


        </HorizontalScrollView>



        <TextView
            android:id="@+id/amountspinnerr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0C0C0C"
            android:elevation="10dp"
            android:hint="Select Card Limit..."
            android:textColorHint="#2E2C2C"
            android:drawableEnd="@drawable/spinner_down"
            android:backgroundTint="#0F0F10"
            android:outlineAmbientShadowColor="@color/white"

            />

        <TextView
            android:layout_width="wrap_content"
            android:textColor="@color/black"
            android:layout_height="18dp"
            android:text="----------------------------------------------------------------------------------------------------------------"

            />



        <!-- Card Details -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Card Details"
            android:layout_marginBottom="5dp"
            android:layout_marginLeft="10dp"
            android:textColor="#1B1C1C"
            />
        <!-- res/layout/card_input.xml -->
        <LinearLayout

            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_border"
            android:padding="6dp">



            <EditText
                android:id="@+id/etCardNumber"
                android:layout_width="230dp"
                android:textColor="#0B0C0C"
                android:textColorHint="#24272B"
                android:layout_height="wrap_content"
                android:hint="Card Number"
                android:inputType="number"
                android:maxLength="19"
                android:padding="10dp"/>

            <ImageView
                android:id="@+id/ivCardType"
                android:layout_width="70dp"
                android:layout_marginLeft="5dp"
                android:layout_height="45dp"

                android:contentDescription="Card Type"/>
        </LinearLayout>


        <TextView
            android:id="@+id/cardErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E1071B"
            android:visibility="gone"
            android:textSize="15sp"
            android:layout_marginLeft="40dp"
            android:text="Card number must be 16 digits" />




        <EditText
            android:id="@+id/validity"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:textColor="#0C0C0C"
            android:layout_marginTop="10dp"
            android:drawablePadding="10dp"
            android:layout_marginHorizontal="10dp"
            android:textColorHint="#24282C"
            android:drawableStart="@drawable/baseline_edit_calendar_24"
            android:background="@drawable/edittext_border"
            android:hint="  MM/YYYY"
            android:focusable="false"
            android:paddingLeft="10dp"
            android:inputType="date" />

        <EditText
            android:id="@+id/cardHolderName"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:textColor="#0C0C0C"
            android:layout_marginHorizontal="5dp"
            android:textColorHint="#24282C"
            android:drawableStart="@drawable/person"
            android:background="@drawable/edittext_border"
            android:layout_height="45dp"
            android:paddingLeft="10dp"
            android:drawablePadding="10dp"
            android:layout_marginLeft="1dp"
            android:hint="Card Holder Name"

            android:inputType="textPersonName" />

        <!-- Buttons -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/clearButton"
                android:layout_width="0dp"
                android:backgroundTint="#E1071B"
                android:textSize="20dp"
                android:elevation="30dp"
                android:textColor="@android:color/white"
                android:clickable="true"
                android:focusable="true"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:text="Clear" />

            <Button
                android:id="@+id/submitButton"
                android:layout_width="0dp"
                android:textSize="20dp"
                android:textColor="@android:color/white"
                android:elevation="20dp"
                android:clickable="true"
                android:focusable="true"
                android:backgroundTint="#79EF39"
                android:layout_margin="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Submit" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
