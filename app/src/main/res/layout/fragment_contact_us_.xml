<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@drawable/backgroundc"
    android:layout_height="match_parent"
    android:scrollbars="none"

    android:padding="30dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingBottom="20dp">

        <!-- CARD 1: Contact Us Box -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            card_view:cardCornerRadius="18dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="#FFFFFF"
            android:layout_marginTop="8dp"
            android:padding="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal">


                <ImageView
                    android:text="Contact Us"
                  android:src="@drawable/cub"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"
                    android:layout_width="180dp"
                    android:layout_height="80dp"
                    android:padding="-50dp"/>



                <TextView
                    android:text="Credit Card Queries"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2B2C30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:backgroundTint="#283593"


                    android:text="Founder/Manager : PDC AZAD"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:textColor="#FCFCFD"
                    android:textSize="17dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:text="Other Services : Mohan Sai"
                    android:backgroundTint="#55E136"
                    android:layout_marginTop="4dp"
                    android:textColor="#FDFEFF"
                    android:textSize="14dp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 2: Contact Icons -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            card_view:cardBackgroundColor="#FFFFFF"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Contact Details"
                    android:textSize="14dp"
                    android:textColor="#0F0F10"
                    android:textStyle="italic" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/down" />

                <!-- Call -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <ImageView

                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/dail" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_arrow_right_alt_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/call_icon"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="10dp"
                        android:text="Call: 9121831491"
                        android:textColor="#1B74CD"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- WhatsApp -->

                <!-- LinkedIn -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView

                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/wattsapp" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_arrow_right_alt_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/whatsapp_icon"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="10dp"
                        android:text="WhatsApp"
                        android:textColor="#1B74CD"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView

                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/linkedin" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_arrow_right_alt_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/linkedin_icon"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="10dp"
                        android:text="LinkedIn Profile"
                        android:textColor="#1B74CD"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Instagram -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView

                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/instagram" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_arrow_right_alt_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/instagram_icon"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="10dp"
                        android:text="Instagram Profile"
                        android:textColor="#1B74CD"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Gmail -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="12dp"
                        android:src="@drawable/mail" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_arrow_right_alt_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="10dp"
                        android:id="@+id/gmail_icon"
                        android:text="pdcazad15082004@gmail.com"
                        android:textColor="#1B74CD"
                        android:textSize="18sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            card_view:cardCornerRadius="12dp"
            card_view:cardElevation="4dp"
            android:layout_marginBottom="100dp"
            card_view:cardBackgroundColor="#FFFFFF"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:orientation="vertical">

                <!-- Heading Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginLeft="20dp"
                        android:src="@drawable/baseline_location_on_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />


                </LinearLayout>

                <!-- Address Text -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="35dp"
                    android:text="40/09/219, Harjunawada Street,\nChennakeshava Nagar,\nBuja Buja Nellore,\nNellore, Andhra Pradesh - 524004, India"
                    android:textSize="16sp"
                    android:textColor="#333333" />

   <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
       android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="20dp"
                    android:text="📍Map ->"
                    android:textColor="#141515"
                    android:textSize="15dp"
                    android:textStyle="bold" />


       <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginLeft="10dp"
           android:layout_marginTop="20dp"
           android:textColor="#1052C5"
           android:id="@+id/map_link"
           android:linksClickable="true"
           android:text="https://maps.app.goo.gl/7eEk3NVC2C5vS1ud8"
           android:textStyle="bold" />

   </LinearLayout>



            </LinearLayout>
        </androidx.cardview.widget.CardView>


    </LinearLayout>
</ScrollView>
